<?xml version="1.0" encoding="UTF-8"?>
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.08">
  <BkToCstmrStmt>
    <GrpHdr>
      <MsgId>${statementRef}</MsgId>
      <CreDtTm>${creationDateTime}</CreDtTm>
    </GrpHdr>
    <Stmt>
      <Id>${statementRef}</Id>
      <Acct>
        <Id><IBAN>${accountIban}</IBAN></Id>
        <Ccy>${currency}</Ccy>
      </Acct>
      <Bal>
        <Tp><CdOrPrtry><Cd>OPBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="${currency}">${openingBalance}</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt><Dt>${statementDate}</Dt></Dt>
      </Bal>
      <Bal>
        <Tp><CdOrPrtry><Cd>CLBD</Cd></CdOrPrtry></Tp>
        <Amt Ccy="${currency}">${closingBalance}</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt><Dt>${statementDate}</Dt></Dt>
      </Bal>
#foreach($tx in $transactions)
      <Ntry>
        <Amt Ccy="${tx.currency}">${tx.amount}</Amt>
        <CdtDbtInd>${tx.cdtDbtInd}</CdtDbtInd>
        <Sts><Cd>BOOK</Cd></Sts>
        <BookgDt><Dt>${tx.bookingDate}</Dt></BookgDt>
        <ValDt><Dt>${tx.valueDate}</Dt></ValDt>
        <NtryDtls><TxDtls><RmtInf><Ustrd>${tx.narrative}</Ustrd></RmtInf></TxDtls></NtryDtls>
      </Ntry>
#end
    </Stmt>
  </BkToCstmrStmt>
</Document>
