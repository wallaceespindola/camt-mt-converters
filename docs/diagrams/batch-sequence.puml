@startuml batch-sequence
!theme plain

skinparam backgroundColor #F8F9FA
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #BDBDBD

skinparam participant {
  BackgroundColor<<browser>>  #FFCCBC
  BorderColor<<browser>>      #E64A19
  FontColor<<browser>>        #BF360C
  BackgroundColor<<api>>      #BBDEFB
  BorderColor<<api>>          #1565C0
  FontColor<<api>>            #0D47A1
  BackgroundColor<<service>>  #C8E6C9
  BorderColor<<service>>      #2E7D32
  FontColor<<service>>        #1B5E20
  BackgroundColor<<batch>>    #E1BEE7
  BorderColor<<batch>>        #6A1B9A
  FontColor<<batch>>          #4A148C
  BackgroundColor<<storage>>  #D7CCC8
  BorderColor<<storage>>      #5D4037
  FontColor<<storage>>        #3E2723
}

skinparam database {
  BackgroundColor #D7CCC8
  BorderColor     #5D4037
  FontColor       #3E2723
}

skinparam collections {
  BackgroundColor #CFD8DC
  BorderColor     #455A64
  FontColor       #263238
}

skinparam note {
  BackgroundColor #FFF9C4
  BorderColor     #F9A825
  FontColor       #333333
}

participant "HTML/JS SPA"                  as FE  <<browser>>
participant "RandomStatementController"    as RS  <<api>>
participant "RandomStatementService"       as SVC <<service>>
participant "StatementConversionController" as CV <<api>>
participant "BatchJobService"              as BJS <<batch>>
participant "BankStatementItemReader"      as IR  <<batch>>
participant "StatementExportProcessor"     as IP  <<batch>>
participant "StatementExportStrategyFactory" as SF <<batch>>
participant "StatementExportStrategy"      as ST  <<batch>>
participant "BankingFileWriter"            as IW  <<batch>>
database    "H2 Database"                  as DB
collections "output/"                      as FS

note over FE,DB #E3F2FD: Phase 1 — Generate random banking statement data

FE  ->  RS:  POST /api/random-statements?loadProfile=LOW
RS  ->  SVC: generate(LOW)
SVC ->  DB:  save BankStatementEntity + BankTransactionEntities
SVC --> RS:  GenerationResult
RS  --> FE:  {firstStatementId, accountsGenerated, statementsGenerated, transactionsGenerated}

note over FE,FS #E8F5E9: Phase 2 — Launch Spring Batch conversion job

FE  ->  CV:  POST /api/conversions\n{statementId:1, targetFormat:MT940, engine:PROWIDE}
CV  ->  BJS: launch(1, MT940, PROWIDE)
BJS ->  IR:  @BeforeStep — load statementId from JobParameters
IR  ->  DB:  findByIdWithTransactions(1)
DB  --> IR:  BankStatementEntity + transactions
BJS ->  IP:  process(BankStatementEntity)
IP  ->  IP:  mapper.toDomain(entity) -> BankStatement
IP  ->  IP:  validator.validate(statement)
IP  ->  SF:  getStrategy(MT940, PROWIDE)
SF  --> IP:  InternalToMt940ProwideStrategy
IP  ->  ST:  export(BankStatement)
ST  --> IP:  GeneratedBankingFile(fileName, contentType, content)
IP  ->  IW:  write([GeneratedBankingFile])
IW  ->  FS:  write statement-1.mt940
IW  --> BJS: COMPLETED + outputFile + fileContent
BJS --> CV:  BatchJobResult
CV  --> FE:  {jobId, status:COMPLETED, outputFile, fileContent}

@enduml
