@startuml strategy-class-diagram
!theme plain

skinparam backgroundColor #FAFAFA
skinparam class {
  BackgroundColor #FFF3E0
  BorderColor #E64A19
  ArrowColor #E64A19
}

interface StatementExportStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
  +key() : StatementExportStrategyKey
}

class StatementExportStrategyFactory {
  -strategies : Map<StatementExportStrategyKey, StatementExportStrategy>
  +getStrategy(fmt : ConversionTargetFormat, eng : ConversionEngine) : StatementExportStrategy
  +hasStrategy(fmt : ConversionTargetFormat, eng : ConversionEngine) : boolean
}

abstract class AbstractMtProwideStrategy {
  #formatSwiftAmount(amount : BigDecimal) : String
  #formatBalanceLine(stmt : BankStatement, balance : BigDecimal, date : LocalDate, credit : boolean) : String
  #formatField61(tx : BankTransaction) : String
  #formatField86(tx : BankTransaction) : String
}

class InternalToMt940ProwideStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToMt942ProwideStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToCamt052ProwideStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToCamt053ProwideStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToMt940VelocityStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToMt942VelocityStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToCamt052VelocityStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

class InternalToCamt053VelocityStrategy {
  +targetFormat() : ConversionTargetFormat
  +engine() : ConversionEngine
  +export(statement : BankStatement) : GeneratedBankingFile
}

StatementExportStrategy <|.. AbstractMtProwideStrategy
StatementExportStrategy <|.. InternalToCamt052ProwideStrategy
StatementExportStrategy <|.. InternalToCamt053ProwideStrategy
StatementExportStrategy <|.. InternalToMt940VelocityStrategy
StatementExportStrategy <|.. InternalToMt942VelocityStrategy
StatementExportStrategy <|.. InternalToCamt052VelocityStrategy
StatementExportStrategy <|.. InternalToCamt053VelocityStrategy
AbstractMtProwideStrategy <|-- InternalToMt940ProwideStrategy
AbstractMtProwideStrategy <|-- InternalToMt942ProwideStrategy
StatementExportStrategyFactory --> StatementExportStrategy

@enduml
