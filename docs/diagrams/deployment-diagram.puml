@startuml deployment-diagram
!theme plain

skinparam backgroundColor #FAFAFA
skinparam node {
  BackgroundColor #FFF3E0
  BorderColor #E64A19
}
skinparam artifact {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

actor "Developer" as DEV

node "Developer Machine" as DEVMACHINE {
  artifact "Source Code" as SRC
  artifact "Maven Build\n(mvn clean package)" as MVN
  artifact "camt-mt-converters-1.0.0-SNAPSHOT.jar" as JAR
  artifact "src/main/resources/static/\n(Pre-built React bundle)" as STATIC
}

node "Runtime — localhost:8080" as RUNTIME {
  artifact "Spring Boot Application\ncamt-mt-converters-1.0.0-SNAPSHOT.jar" as SB
  database "H2 In-Memory DB\nbankingdb" as H2
  folder "output/\n(Generated banking files)" as OUTPUT
  artifact "Static Resources\nReact SPA served at /" as STATIC_SRV
}

actor "Browser\nlocalhost:8080" as CLIENT

DEV --> SRC
SRC --> MVN
MVN --> JAR
JAR --> SB
STATIC --> SB
SB --> H2
SB --> OUTPUT
SB --> STATIC_SRV
CLIENT --> STATIC_SRV
CLIENT --> SB : REST API calls

@enduml
